{
    "name": "pr-tracker",
    "version": "1.0.20",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "wxt build",
        "build:all": "npm run build && npm run build:firefox",
        "build:e2e": "wxt build --mode test",
        "build:firefox": "wxt build -b firefox",
        "check-format": "prettier --check .",
        "compile": "tsc --noEmit",
        "dev": "wxt",
        "format": "sort-package-json \"package.json\" \"tsconfig*.json\" && prettier --write .",
        "postinstall": "wxt prepare",
        "lint": "oxlint .",
        "prepare": "husky",
        "test": "npm run test:unit",
        "test:all": "npm run test:unit && npm run test:e2e",
        "test:e2e": "npm run build:e2e && vitest run --config vitest.e2e.config.ts --reporter=verbose tests/e2e",
        "test:e2e:screenshots": "npm run build:e2e && vitest run --config vitest.e2e.config.ts --reporter=verbose tests/screenshot.e2e.test.ts",
        "test:headless": "cross-env CI=true npm run test:e2e",
        "test:unit": "vitest run --reporter=verbose .unit.test",
        "zip": "wxt zip"
    },
    "prettier": {
        "bracketSpacing": true,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "es5"
    },
    "dependencies": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-icons": "^5.5.0",
        "webextension-polyfill": "^0.12.0",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@types/chrome": "^0.1.32",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/webextension-polyfill": "^0.12.4",
        "@vitest/ui": "5.0.0",
        "@wxt-dev/module-react": "^1.2.2",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "oxlint": "^1.83.0",
        "prettier": "^3.7.4",
        "puppeteer": "^25.11.0",
        "sort-package-json": "^3.6.0",
        "tailwindcss": "^4.1.18",
        "typescript": "^7.0.2",
        "vite": "^7.3.0",
        "vitest": "5.0.0",
        "vitest-puppeteer": "^11.0.3",
        "wxt": "^0.21.4"
    },
    "allowScripts": {
        "puppeteer@25.11.0": true,
        "esbuild@0.27.2": true
    }
}
